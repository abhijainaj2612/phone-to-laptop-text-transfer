# Relay server only: generate a long unique value, e.g. Python secrets.token_urlsafe(48)
SECRET_KEY=replace-with-a-unique-48-character-or-longer-secret
PAIRING_CODE_EXPIRY=86400
MAX_MESSAGE_SIZE=50000
RATE_LIMIT=30
# PC client only: the public HTTPS URL of your deployed relay
RELAY_URL=https://relay.example.com
TYPING_SPEED=normal
